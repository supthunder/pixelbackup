<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixel Backup" Width="800" Height="606" MinWidth="460" MinHeight="350"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="#252820" Background="#F8F7F2" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#F8F7F2"/>
        <SolidColorBrush x:Key="Ink" Color="#252820"/>
        <SolidColorBrush x:Key="Muted" Color="#56594F"/>
        <SolidColorBrush x:Key="Rule" Color="#C8CBC0"/>
        <SolidColorBrush x:Key="Panel" Color="#202822"/>
        <SolidColorBrush x:Key="Ember" Color="#A53C25"/>
        <SolidColorBrush x:Key="LightInk" Color="#FCF9EB"/>
        <SolidColorBrush x:Key="LightMuted" Color="#C3C8B8"/>
        <SolidColorBrush x:Key="Amber" Color="#FFC176"/>
        <Style x:Key="FocusRing" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate><Rectangle Margin="2" Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" StrokeThickness="2" StrokeDashArray="2 1" IsHitTestVisible="False"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#929688"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7E8DF"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#D7DBD0"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.52"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Ember}"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="MinWidth" Value="135"/>
            <Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="19,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#87331F"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#702918"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}"/>
        <Style x:Key="DisclosureButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" Padding="2,12,5,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            <Path x:Name="Chevron" Grid.Column="1" Width="10" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M 0,0 L 5,5 10,0" Stretch="Fill" Stroke="{StaticResource Muted}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="#EEEFE7"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Disclosure" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource DisclosureButton}"
                                      AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ContentPresenter ContentSource="Header"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="Detail" Visibility="Collapsed" Margin="2,0,2,14"/>
                    </StackPanel>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Detail" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Meta" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="#EEEFE7"/>
            <Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MaxWidth="890" Margin="32,25,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,21">
                <TextBlock Text="Share a folder" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                <TextBlock Text="Your Pixel reads photos and videos over Wi-Fi. The originals stay on this PC." Style="{StaticResource Body}" Margin="1,3,0,0"/>
            </StackPanel>

            <Border x:Name="FolderDropSurface" Grid.Row="1" AllowDrop="True" CornerRadius="4" BorderThickness="2" Padding="20,17,20,18"
                    AutomationProperties.Name="Drop a folder from this PC">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Panel}"/>
                    <Style.Triggers><Trigger Property="Tag" Value="Dragging"><Setter Property="BorderBrush" Value="{StaticResource Amber}"/><Setter Property="Background" Value="#303C30"/></Trigger></Style.Triggers>
                </Style></Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <Viewbox Width="44" Height="39" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Canvas Width="46" Height="39">
                                <Path Data="M3,29 L3,9 Q3,7 5,7 L15,7 19,12 37,12 Q39,12 39,14 L39,19" Stroke="{StaticResource LightInk}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                <Path Data="M10,17 L10,4 28,4 33,9 33,17" Fill="{StaticResource Panel}" Stroke="{StaticResource LightInk}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                <Path Data="M12,15 L18,10 22,13 26,10 31,15 Z" Fill="{StaticResource Amber}"/>
                                <Path Data="M3,32 L7,18 Q7.5,16.5 9,16.5 L41,16.5 Q43,16.5 42.4,18.5 L38.5,31.5 Q38,34 36,34 L5.5,34 Q3.5,34 3,32 Z" Fill="{StaticResource Panel}" Stroke="{StaticResource LightInk}" StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Grid x:Name="ConnectionLine" Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Grid.Resources>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="#849283"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, ElementName=ConnectionLine}" Value="Sharing"><Setter Property="Stroke" Value="#C6CEB8"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, ElementName=ConnectionLine}" Value="Reading"><Setter Property="Stroke" Value="{StaticResource Amber}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Resources>
                            <Path Data="M0,1 L100,1" Height="1.5" Stretch="Fill" StrokeThickness="1.5" StrokeDashArray="3,3" VerticalAlignment="Center"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L5,4 0,8" StrokeThickness="1.5"/>
                            <Border Background="{Binding Background, ElementName=FolderDropSurface}" Padding="10,0" HorizontalAlignment="Center">
                                <TextBlock Foreground="{StaticResource LightMuted}" Text="Wi-Fi" FontSize="12" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Viewbox Grid.Column="2" Width="27" Height="40" HorizontalAlignment="Right" IsHitTestVisible="False">
                            <Canvas Width="25" Height="39">
                                <Rectangle Canvas.Left="2" Canvas.Top="1.5" Width="21" Height="35" RadiusX="3.5" RadiusY="3.5" Stroke="{StaticResource LightInk}" StrokeThickness="1.9"/>
                                <Rectangle Canvas.Left="5.5" Canvas.Top="7" Width="14" Height="21" Fill="#3D4A3F"/>
                                <Path Data="M6,26 L11,20 14,23 17,20 19,23 19,27 6,27 Z" Fill="{StaticResource Amber}"/>
                                <Path Data="M10,4.5 L15,4.5 M11,32 L14,32" Stroke="{StaticResource LightInk}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,8,20,0">
                        <TextBlock Text="This PC" Foreground="{StaticResource LightMuted}" FontSize="12"/>
                        <TextBlock x:Name="SourceName" Text="Drop a folder here" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource LightInk}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FolderPath" FontFamily="Consolas, Segoe UI" FontSize="12" Foreground="{StaticResource LightMuted}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,4,0,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                        <TextBlock Text="Your Pixel" TextAlignment="Right" FontSize="12" Foreground="{StaticResource LightMuted}"/>
                        <TextBlock Text="Google Photos" TextAlignment="Right" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource LightInk}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="ShareButton" Content="Start sharing" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,4"/>
                    <Button x:Name="ChooseFolder" Content="Choose folder…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
                    <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Margin="0,0,0,4"/>
                </WrapPanel>
                <ProgressBar x:Name="ProgressBar" Visibility="Collapsed" Height="3" Foreground="{StaticResource Ember}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel x:Name="StatusArea" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="StatusDetail" Style="{StaticResource Body}" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,24,0,0">
                <Border Height="1" Background="{StaticResource Rule}"/>
                <Expander x:Name="FilesExpander" Visibility="Collapsed" Style="{StaticResource Disclosure}" AutomationProperties.Name="Files in the folder">
                    <Expander.Header>
                        <DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="Files" FontSize="16" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock x:Name="FileSummary" Style="{StaticResource Meta}" TextAlignment="Right"/>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DataGrid x:Name="FileTable" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="True" CanUserResizeRows="False"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" MaxHeight="200" RowHeight="28" GridLinesVisibility="None"
                                  Background="{StaticResource Paper}" RowBackground="{StaticResource Paper}" AlternatingRowBackground="#F0F1EA" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                                  AutomationProperties.Name="Photos and videos to share" SelectionMode="Single">
                            <DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Bytes" Width="99"/></DataGrid.Columns>
                        </DataGrid>
                        <Expander x:Name="NotesExpander" Header="Folder notes" Style="{StaticResource Disclosure}" Visibility="Collapsed" AutomationProperties.Name="Folder notes">
                            <ListBox x:Name="NotesList" MaxHeight="155" Background="{StaticResource Paper}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Skipped files and folders">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                        <Button x:Name="ScanButton" Content="Refresh file list" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Expander>
                <Border Height="1" Background="{StaticResource Rule}" Visibility="{Binding Visibility, ElementName=FilesExpander}"/>
                <Expander x:Name="SetupExpander" Style="{StaticResource Disclosure}" AutomationProperties.Name="Pixel setup">
                    <Expander.Header>
                        <DockPanel><TextBlock DockPanel.Dock="Left" Text="Pixel setup" FontSize="16" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock x:Name="SetupSummary" Text="Checking Windows access…" Style="{StaticResource Meta}" TextAlignment="Right"/>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="To pair a Pixel, unlock it, enable USB debugging and connect it by USB." Style="{StaticResource Body}"/>
                        <TextBlock x:Name="UsbDeviceStatus" Style="{StaticResource OptionalText}"/>
                        <TextBlock x:Name="SetupStatus" Style="{StaticResource OptionalText}" AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,10,0,5">
                            <Button x:Name="PairPhone" Content="Pair Pixel…" Margin="0,0,8,4"/>
                            <Button x:Name="CancelSetup" Content="Cancel" Visibility="Collapsed" Margin="0,0,8,4"/>
                        </WrapPanel>
                        <Expander Header="Advanced options" Style="{StaticResource Disclosure}" AutomationProperties.Name="Advanced options">
                            <StackPanel>
                                <TextBlock x:Name="UsbToolsStatus" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ExpiryStatus" Style="{StaticResource OptionalText}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="GetUsbTools" Content="Prepare USB tools…" Margin="0,0,8,8"/>
                                    <Button x:Name="BrowseAdb" Content="Choose adb.exe…" Margin="0,0,8,8"/>
                                    <Button x:Name="UpdateWatcher" Content="Update backup helper" Margin="0,0,8,8"/>
                                    <Button x:Name="AccessButton" Content="Allow folder access…" Margin="0,0,8,8"/>
                                    <Button x:Name="OpenGuide" Content="Setup guide" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Expander>
                <Border Height="1" Background="{StaticResource Rule}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
