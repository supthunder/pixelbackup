<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Shell" Title="Pixel Backup" Width="1080" Height="754" MinWidth="850" MinHeight="640"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" FontFamily="Inter, Segoe UI" FontSize="14"
        Foreground="#1D2C36" Background="#F6F5F1" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" Language="en-US">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#F6F5F1"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#1D2C36"/>
        <SolidColorBrush x:Key="Muted" Color="#52626B"/>
        <SolidColorBrush x:Key="Line" Color="#D7DCD9"/>
        <SolidColorBrush x:Key="Navy" Color="#172833"/>
        <SolidColorBrush x:Key="Cobalt" Color="#2157CF"/>
        <SolidColorBrush x:Key="Mint" Color="#67D4BF"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="#BAC5CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Face" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Wash" CornerRadius="5" Background="#132B52" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Border x:Name="FocusRing" CornerRadius="4" Margin="2" BorderBrush="#FC9D20"
                                    BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.08"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.18"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Background" Value="#EBEEEC"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#CFD5D3"/>
                                <Setter Property="Foreground" Value="#68757B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Cobalt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cobalt}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="WhenAvailable" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DAE4E9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="NavFace" Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="ActiveBar" Width="3" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource Mint}" CornerRadius="1.5" Visibility="Collapsed"/>
                            <ContentPresenter Margin="13,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            <Border x:Name="NavFocus" CornerRadius="4" Margin="1" BorderThickness="2" BorderBrush="{StaticResource Mint}"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavFace" Property="Background" Value="#253C49"/></Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Visibility.Visible}">
                                <Setter TargetName="NavFace" Property="Background" Value="#2B4652"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavFace" Property="Background" Value="#34545F"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavFocus" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailIcon" TargetType="Path">
            <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/><Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.55"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
        <Style x:Key="FileCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="DecisionText" TargetType="TextBlock" BasedOn="{StaticResource FileCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Decision}" Value="Ready"><Setter Property="Foreground" Value="#176354"/></DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="Folder copy"><Setter Property="Foreground" Value="#795023"/></DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="Known copy"><Setter Property="Foreground" Value="#63517D"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Paper}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Navy}">
            <DockPanel Margin="12,20,12,15" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="3,0,0,32" VerticalAlignment="Center">
                    <Viewbox Width="37" Height="37" Margin="0,0,4,0" IsHitTestVisible="False">
                        <Canvas Width="64" Height="64">
                            <Path Fill="#4B80F0" Data="M13,15 H25 Q27,15 28.5,16.5 L33,21 H47 Q51,21 51,25 V42 Q51,46 47,46 H13 Q9,46 9,42 V19 Q9,15 13,15 Z"/>
                            <Path Fill="#67D4BF" Data="M19,25 H51 Q55,25 55,29 V46 Q55,50 51,50 H19 Q15,50 15,46 V29 Q15,25 19,25 Z"/>
                            <Path Fill="#172833" Data="M21,44 L28.4,36 Q29,35.3 29.6,36 L33.2,39.8 L37.3,35 Q38,34.1 38.7,35 L47,44 Z"/>
                            <Ellipse Canvas.Left="43" Canvas.Top="29.5" Width="5" Height="5" Fill="#172833"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Pixel Backup" Foreground="White" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#354A55" Margin="5,0,5,9"/>
                    <TextBlock Text="Library profile" Foreground="#A9C1CC" FontSize="12" Margin="8,1,5,2"/>
                    <TextBlock Text="{Binding SelectedItem, ElementName=ProfileSelect, TargetNullValue='My library', FallbackValue='My library'}"
                               Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="8,0,5,5" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <StackPanel>
                    <Button x:Name="NavBackup" Style="{StaticResource RailButton}" Tag="{Binding Visibility, ElementName=BackupView}" AutomationProperties.Name="Backup">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RailIcon}" Data="M3,16 H17 M5,13 V15 M15,13 V15 M10,12 V3 M6.5,6.5 L10,3 L13.5,6.5"/><TextBlock Text="Backup"/></StackPanel>
                    </Button>
                    <Button x:Name="NavLibrary" Style="{StaticResource RailButton}" Tag="{Binding Visibility, ElementName=LibraryView}" AutomationProperties.Name="Library">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RailIcon}" Data="M3,3.5 H6.5 V17 H3 Z M9,3.5 H12.5 V17 H9 Z M14.5,4.5 L16.8,3.8 L20.4,16.3 L18.1,17 Z"/><TextBlock Text="Library"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSetup" Style="{StaticResource RailButton}" Tag="{Binding Visibility, ElementName=SetupView}" AutomationProperties.Name="Setup">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource RailIcon}" Data="M3,6 H11 M15,6 H19 M3,14 H6 M10,14 H19 M11,3.5 H15 V8.5 H11 Z M6,11.5 H10 V16.5 H6 Z"/><TextBlock Text="Setup"/></StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="BackupView" Grid.Column="1" Margin="25,18,24,17">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PageTitle}" Text="Backup"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly" VerticalContentAlignment="Stretch">
                <Grid Margin="0,0,2,1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="136"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="15,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="37" Height="37" Margin="0,0,12,0" Background="#E8F3EF" CornerRadius="7" VerticalAlignment="Center">
                                    <Path Width="21" Height="17" Stretch="Uniform" Stroke="#216658" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          Data="M2,7 V4.5 Q2,3 3.5,3 H8 L10.5,5.5 H18.5 Q20,5.5 20,7 V15.5 Q20,17 18.5,17 H3.5 Q2,17 2,15.5 Z M2,8 H20"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Source folder" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="FolderPath" Text="No folder selected" FontSize="13" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Selected folder"/>
                                </StackPanel>
                                <Button x:Name="ChooseFolder" Grid.Column="2" VerticalAlignment="Center" Content="Choose folder">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FolderPath}" Value="No folder selected">
                                                    <Setter Property="Background" Value="{StaticResource Cobalt}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Cobalt}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="15,7">
                                <DockPanel LastChildFill="True">
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button x:Name="AccessButton" Style="{StaticResource WhenAvailable}" IsEnabled="False" Content="Grant reader access" Margin="0,0,6,0"/>
                                        <Button x:Name="ScanButton" Style="{StaticResource ButtonBase}" IsEnabled="False" Content="Rescan"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="SkipCopies" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                              AutomationProperties.Name="Skip exact matches" ToolTip="Exclude byte-for-byte matches from this share.">
                                        <TextBlock Text="Skip exact matches" TextWrapping="Wrap" Margin="3,0,0,0" FontSize="13"/>
                                    </CheckBox>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="1,13,1,13">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TotalCount" Style="{StaticResource Count}" Text="0" AutomationProperties.Name="Files found"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Files found"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                            <StackPanel><TextBlock x:Name="ReadyCount" Style="{StaticResource Count}" Foreground="{StaticResource Cobalt}" Text="0" AutomationProperties.Name="Ready to share"/><TextBlock Style="{StaticResource Caption}" Text="Ready to share"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16,0,0,0">
                            <StackPanel><TextBlock x:Name="CopyCount" Style="{StaticResource Count}" Text="0" AutomationProperties.Name="Exact matches"/><TextBlock Style="{StaticResource Caption}" Text="Exact matches"/></StackPanel>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,0,0,6" LastChildFill="True">
                        <Button x:Name="WarningsButton" DockPanel.Dock="Right" Style="{StaticResource WhenAvailable}" IsEnabled="False" Content="Review warnings" MinHeight="27" Padding="9,3" ToolTip="See files the scan skipped or could not read."/>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="File review" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True" Padding="1" CornerRadius="6">
                        <Grid>
                            <!-- The list gets the available viewport even when the surrounding form scrolls. -->
                            <Canvas x:Name="FileViewport" ClipToBounds="True">
                            <DataGrid x:Name="FileTable" AutomationProperties.Name="File review" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      Width="{Binding ActualWidth, ElementName=FileViewport}" Height="{Binding ActualHeight, ElementName=FileViewport}"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" EnableRowVirtualization="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0" RowHeaderWidth="0" FontSize="13"
                                      Background="White" RowBackground="White" AlternatingRowBackground="#F8FAF9" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E7EBE9" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EAF0EE"/>
                                        <Setter Property="Foreground" Value="#364A51"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderBrush" Value="#D7DEDB"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#DAE8FF"/><Setter Property="Foreground" Value="#173967"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Cobalt}"/><Setter Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" SortMemberPath="RelativePath" ElementStyle="{StaticResource FileCellText}" Width="2.45*" MinWidth="112"/>
                                    <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" SortMemberPath="Decision" ElementStyle="{StaticResource DecisionText}" Width="1.25*" MinWidth="84"/>
                                    <DataGridTextColumn Header="Match" Binding="{Binding Match}" SortMemberPath="Match" ElementStyle="{StaticResource FileCellText}" Width="1.65*" MinWidth="88"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" ElementStyle="{StaticResource FileCellText}" Width="0.75*" MinWidth="65" CanUserSort="False"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Canvas>
                            <TextBlock IsHitTestVisible="False" Margin="12,28,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Setter Property="Text" Value="No files to review"/><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=FileTable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=ProgressBar}" Value="{x:Static Visibility.Visible}"><Setter Property="Text" Value="Scanning files…"/></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Expander Grid.Row="4" Header="Connection details" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" HorizontalContentAlignment="Stretch">
                        <Grid Margin="18,6,8,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="83"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Share" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ShareStatus" Grid.Column="1" Text="No active share" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="Reader" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ReaderStatus" Grid.Row="1" Grid.Column="1" Text="No connection" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="Expires" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ExpiryStatus" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap"/>
                        </Grid>
                    </Expander>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,9,2,0" Padding="0,9,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Choose a folder to begin" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="66" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,2,0,0">
                        <TextBlock x:Name="StatusDetail" Text="Review the files before sharing them with your Pixel." Style="{StaticResource Caption}"/>
                    </ScrollViewer>
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="4" Margin="0,7,0,1" Visibility="Collapsed"
                                 Background="#D8DFDD" BorderThickness="0" Foreground="{StaticResource Cobalt}" AutomationProperties.Name="Scan progress"/>
                    <WrapPanel Margin="0,7,0,-3">
                        <Button x:Name="ShareButton" Style="{StaticResource PrimaryButton}" Content="Start sharing" IsEnabled="False" Margin="0,0,7,3"/>
                        <Button x:Name="StopButton" Style="{StaticResource WhenAvailable}" Content="Stop sharing" IsEnabled="False" Margin="0,0,7,3"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource ButtonBase}" Content="Confirm backup" IsEnabled="False" Margin="0,0,7,3" ToolTip="Record a backup you have verified in Google Photos."/>
                        <Button x:Name="CancelButton" Style="{StaticResource WhenAvailable}" Content="Cancel" IsEnabled="False" Margin="0,0,7,3" ToolTip="Cancel the current scan."/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="LibraryView" Grid.Column="1" Visibility="Collapsed" Margin="25,18,24,17">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PageTitle}" Text="Library"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False">
                <StackPanel Margin="0,0,2,3">
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="Library profile" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="NewProfile" DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Content="New profile" Margin="7,0,0,0"/>
                                <ComboBox x:Name="ProfileSelect" IsEditable="False" MinHeight="34" FontSize="14" VerticalContentAlignment="Center" Padding="7,3" AutomationProperties.Name="Library profile"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Select the local catalog for the Google account you’re backing up." Margin="0,5,0,0"/>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,10"/>
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button x:Name="ExportReport" Style="{StaticResource ButtonBase}" Content="Export report" Margin="0,0,7,0"/>
                                    <Button x:Name="ClearCatalog" Style="{StaticResource ButtonBase}" Content="Clear catalog"/>
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="Known files in the catalog"/>
                                    <TextBlock x:Name="LibraryCount" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Cobalt}" TextWrapping="Wrap" AutomationProperties.Name="Catalog count"/>
                                </StackPanel>
                            </DockPanel>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,11,0,0">
                                <TextBlock Style="{StaticResource Body}" Text="Exact matches are identified by file contents. A renamed copy can still match a catalog entry."/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Import known files" Margin="0,18,0,6"/>
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="Choose a folder of backed-up media or a Google Takeout ZIP to add its file fingerprints."/>
                            <WrapPanel Margin="0,10,0,-3">
                                <Button x:Name="ImportFolder" Style="{StaticResource ButtonBase}" Content="Import folder" Margin="0,0,7,3"/>
                                <Button x:Name="ImportZip" Style="{StaticResource ButtonBase}" Content="Import ZIP" Margin="0,0,7,3"/>
                                <Button x:Name="CancelImport" Style="{StaticResource WhenAvailable}" Content="Cancel import" IsEnabled="False" Margin="0,0,7,3"/>
                            </WrapPanel>
                            <TextBlock x:Name="ImportStatus" Style="{StaticResource Caption}" Text="" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Catalog activity" Margin="0,18,0,6"/>
                    <Border Style="{StaticResource Card}" Padding="1">
                        <Grid Height="157">
                            <ListBox x:Name="AuditList" AutomationProperties.Name="Catalog activity" BorderThickness="0" Background="Transparent" Padding="4" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="7,4"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No catalog activity yet" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=AuditList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="SetupView" Grid.Column="1" Visibility="Collapsed" Margin="25,18,24,17">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource PageTitle}" Text="Setup"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False">
                <StackPanel Margin="0,0,2,3">
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" Background="#E8F3EF" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Path Data="M5,2 H13 Q15,2 15,4 V17 Q15,19 13,19 H5 Q3,19 3,17 V4 Q3,2 5,2 Z M7.5,16.5 H10.5"
                                          Stroke="#216658" StrokeThickness="1.6" StrokeLineJoin="Round" Height="21" Width="15" Stretch="Uniform"/>
                                </Border>
                                <StackPanel><TextBlock Text="Pixel connection" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="PairingStatus" Style="{StaticResource Body}" Text="Pair your Pixel to use this PC as a photo source." Margin="0,3,0,0"/></StackPanel>
                            </DockPanel>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Windows reader" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Text, ElementName=ReaderStatus}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,12,0,-3">
                                <Button x:Name="PairPhone" Style="{StaticResource PrimaryButton}" Content="Pair phone" Margin="0,0,7,3"/>
                                <Button x:Name="UpdateWatcher" Style="{StaticResource ButtonBase}" Content="Update phone watcher" Margin="0,0,7,3"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Pairing and maintenance" Margin="0,18,0,6"/>
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="The setup guide covers USB pairing, the Windows reader account and the service that watches for folders on your PC."/>
                            <WrapPanel Margin="0,11,0,-3">
                                <Button x:Name="OpenGuide" Style="{StaticResource ButtonBase}" Content="Open setup guide" Margin="0,0,7,3"/>
                                <Button x:Name="OpenPhotos" Style="{StaticResource ButtonBase}" Content="Open Google Photos" Margin="0,0,7,3" ToolTip="Open Google Photos in your browser."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
