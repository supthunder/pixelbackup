<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Shell" Title="Pixel Backup" Width="1160" Height="790" MinWidth="850" MinHeight="640"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="#182A24" Background="#F7F7F2" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Paper" Color="#F7F7F2"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ink" Color="#182A24"/>
        <SolidColorBrush x:Key="Muted" Color="#506159"/>
        <SolidColorBrush x:Key="Line" Color="#D7DED7"/>
        <SolidColorBrush x:Key="StrongLine" Color="#A6B6AB"/>
        <SolidColorBrush x:Key="Navy" Color="#142C27"/>
        <SolidColorBrush x:Key="Cobalt" Color="#175942"/>
        <SolidColorBrush x:Key="Primary" Color="#175942"/>
        <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Mint" Color="#BAEBC9"/>
        <SolidColorBrush x:Key="Gentle" Color="#E4F1E6"/>
        <SolidColorBrush x:Key="Tint" Color="#EDF0E9"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#815219"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#176445"/>
        <FontFamily x:Key="TitleFace">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="LabelFace">Segoe UI Variable Small, Segoe UI</FontFamily>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TitleFace}"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TitleFace}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LabelFace}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TitleFace}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- A two-tone keyboard focus ring stays distinguishable on both the rail and paper. -->
        <Style x:Key="ControlFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid IsHitTestVisible="False">
                            <Border Margin="1" CornerRadius="5" BorderBrush="White" BorderThickness="2"/>
                            <Border Margin="3" CornerRadius="3" BorderBrush="#153F33" BorderThickness="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrongLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Wash" CornerRadius="6" Background="#123B2D" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Background" Value="#E9EDE7"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="#D1D9D0"/>
                                <Setter TargetName="Wash" Property="Opacity" Value="0"/>
                                <Setter Property="Foreground" Value="#647167"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
        <Style x:Key="WhenAvailable" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Preserve native CheckBox/ComboBox input, automation and editable/high-contrast templates. -->
        <ControlTemplate x:Key="CheckTemplate" TargetType="CheckBox">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="18" Height="18" VerticalAlignment="Center">
                    <Border x:Name="CheckFace" CornerRadius="3" BorderBrush="{StaticResource StrongLine}" BorderThickness="1"
                            Background="{StaticResource Surface}"/>
                    <Path x:Name="Tick" Data="M2,5.5 L5.7,9 L12,2" Width="12" Height="8" Stretch="Uniform" Stroke="White"
                          StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                    <Border x:Name="Mixed" Width="9" Height="2" Background="White" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFace" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckFace" Property="Background" Value="{StaticResource Primary}"/>
                    <Setter TargetName="CheckFace" Property="BorderBrush" Value="{StaticResource Primary}"/>
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="CheckFace" Property="Background" Value="{StaticResource Primary}"/>
                    <Setter TargetName="Mixed" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.58"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="28"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False">
                    <Setter Property="Template" Value="{StaticResource CheckTemplate}"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ChoiceTemplate" TargetType="ComboBox">
            <Grid x:Name="ChoiceBody">
                <ToggleButton x:Name="ChoiceToggle" Focusable="False" IsTabStop="False" ClickMode="Press" Cursor="Hand"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ChoiceFace" CornerRadius="5" BorderBrush="{StaticResource StrongLine}"
                                    BorderThickness="1" Background="{StaticResource Surface}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFace" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceFace" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceFace" Property="Background" Value="{StaticResource Tint}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="11,0,32,0"
                                  VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Path Data="M1,2 L5,6 L9,2" Stroke="{StaticResource Muted}" StrokeThickness="1.7" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="7" Stretch="Uniform" Margin="0,0,12,0"
                      IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}">
                    <Border MinWidth="{Binding ActualWidth, ElementName=ChoiceBody}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,0"
                            Background="{StaticResource Surface}" BorderBrush="{StaticResource StrongLine}" BorderThickness="1" CornerRadius="5" Padding="3">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#657268"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEditable, RelativeSource={RelativeSource Self}}" Value="False"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Template" Value="{StaticResource ChoiceTemplate}"/>
                    <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D2DFD5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0,31,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="NavFace" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            <Path x:Name="ActiveBar" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                  Data="M2,5.5 H11 M7.5,2 L11,5.5 L7.5,9" Width="11" Height="9" Stretch="Uniform"
                                  Stroke="#164B37" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavFace" Property="Background" Value="#254337"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavFace" Property="Background" Value="#32553F"/></Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static Visibility.Visible}">
                                <Setter TargetName="NavFace" Property="Background" Value="{StaticResource Mint}"/>
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#173C2C"/>
                                <Setter Property="AutomationProperties.ItemStatus" Value="Current page"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailIcon" TargetType="Path">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Margin" Value="0,0,11,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.65"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="FileCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="DecisionText" TargetType="TextBlock" BasedOn="{StaticResource FileCellText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Decision}" Value="Ready"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="Folder copy"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Decision}" Value="Known copy"><Setter Property="Foreground" Value="#5D4D78"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Paper}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*" MinWidth="182" MaxWidth="202"/>
            <ColumnDefinition Width="83*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Navy}">
            <Grid Margin="13,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="4,25,0,33" AutomationProperties.Name="Pixel Backup">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Width="34" Height="34" Margin="0,0,7,0" IsHitTestVisible="False" VerticalAlignment="Center"
                           Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource TitleFace}"
                               FontSize="19" FontWeight="SemiBold" Foreground="#F4FAF3" Text="Pixel Backup"/>
                </Grid>
                <StackPanel Grid.Row="1" KeyboardNavigation.TabNavigation="Continue">
                    <Button x:Name="NavBackup" Style="{StaticResource RailButton}" AutomationProperties.Name="Backup"
                            Tag="{Binding Visibility, ElementName=BackupView}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIcon}" Data="M3,13 V17 Q3,18 4,18 H16 Q17,18 17,17 V13 M10,13 V2 M5.5,6.5 L10,2 L14.5,6.5"/>
                            <TextBlock Text="Backup" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLibrary" Style="{StaticResource RailButton}" AutomationProperties.Name="Library"
                            Tag="{Binding Visibility, ElementName=LibraryView}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIcon}" Data="M3,3 H6.5 V18 H3 Z M9,3 H12.5 V18 H9 Z M15,4.5 L17.1,4 L20.3,17.4 L18.2,18 Z"/>
                            <TextBlock Text="Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSetup" Style="{StaticResource RailButton}" AutomationProperties.Name="Setup"
                            Tag="{Binding Visibility, ElementName=SetupView}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource RailIcon}" Data="M2,6 H11 M15,6 H19 M2,14 H6 M10,14 H19 M11,3.5 H15 V8.5 H11 Z M6,11.5 H10 V16.5 H6 Z"/>
                            <TextBlock Text="Setup" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="#375346" BorderThickness="0,1,0,0" Margin="4,0,4,15" Padding="0,12,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="31" Height="31" CornerRadius="5" BorderThickness="1" BorderBrush="#456553"
                                Background="#1E392E" VerticalAlignment="Center" Margin="0,0,9,0">
                            <Path Data="M6.5,7 C6.5,5.1 7.9,3.7 10,3.7 C12.1,3.7 13.5,5.1 13.5,7 C13.5,8.9 12.1,10.3 10,10.3 C7.9,10.3 6.5,8.9 6.5,7 Z M3.5,16.5 C4,13.7 6.6,12 10,12 C13.4,12 16,13.7 16.5,16.5"
                                  Stroke="#C3E2CC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Library profile" FontFamily="{StaticResource LabelFace}" FontSize="12" Foreground="#AEC5B6"/>
                            <TextBlock Text="{Binding SelectedItem, ElementName=ProfileSelect, TargetNullValue='My library', FallbackValue='My library'}"
                                       FontWeight="SemiBold" Foreground="#F4FAF3" FontSize="14" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Grid x:Name="BackupView" Grid.Column="1" Margin="25,18,25,17">
            <Grid.Resources>
                <Style x:Key="BackupCard" TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="CornerRadius" Value="12"/>
                    <Setter Property="BorderBrush" Value="#DCE5DC"/>
                </Style>
                <Style x:Key="BackupLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style x:Key="BackupCardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                    <Setter Property="FontSize" Value="17"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                </Style>
                <Style x:Key="BackupCount" TargetType="TextBlock" BasedOn="{StaticResource Count}">
                    <Setter Property="FontSize" Value="26"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
                <Style x:Key="BackupDecisionLabel" TargetType="TextBlock" BasedOn="{StaticResource FileCellText}">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#443F36"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Decision}" Value="Ready"><Setter Property="Foreground" Value="#225943"/></DataTrigger>
                        <DataTrigger Binding="{Binding Decision}" Value="Known copy"><Setter Property="Foreground" Value="#554474"/></DataTrigger>
                        <DataTrigger Binding="{Binding Decision}" Value="Folder copy"><Setter Property="Foreground" Value="#775026"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <ScrollViewer x:Name="WelcomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" PanningMode="VerticalOnly" VerticalContentAlignment="Stretch">
                <Grid Margin="0,0,1,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="270" MaxHeight="335"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="FolderDropSurface" CornerRadius="16" Background="#16342B" BorderThickness="2" AllowDrop="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="Dragging"><Setter Property="BorderBrush" Value="#94E2B9"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Image x:Name="WelcomeArt" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border CornerRadius="14" IsHitTestVisible="False">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Source, ElementName=WelcomeArt}" Stretch="UniformToFill"
                                                AlignmentX="Right" AlignmentY="Center"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="14" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF17352C" Offset="0"/>
                                        <GradientStop Color="#FF17352C" Offset="0.27"/>
                                        <GradientStop Color="#F017352C" Offset="0.44"/>
                                        <GradientStop Color="#A617352C" Offset="0.63"/>
                                        <GradientStop Color="#3917352C" Offset="0.82"/>
                                        <GradientStop Color="#0A17352C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="28,22" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="408">
                                <TextBlock FontSize="43" FontWeight="SemiBold" LineHeight="46" LineStackingStrategy="BlockLineHeight"
                                           Foreground="#FFFDF6" AutomationProperties.Name="Back up your photos">
                                    <Run Text="Back up your"/><LineBreak/><Run Text="photos"/>
                                </TextBlock>
                                <TextBlock FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,10,0,0"
                                           Foreground="#DEECE3" TextWrapping="Wrap" MaxWidth="332" HorizontalAlignment="Left"
                                           Text="Share a folder from this PC. Your Pixel backs up the originals to Google Photos."/>
                                <WrapPanel Margin="0,17,0,0">
                                    <Button x:Name="ChooseFolder" Style="{StaticResource ButtonBase}" Background="#D9F0DE"
                                            BorderBrush="#D9F0DE" Foreground="#184132" FontSize="14" MinHeight="42"
                                            Padding="16,8" Margin="0,0,10,5" Content="Choose folder"/>
                                    <Grid VerticalAlignment="Top" Height="42" Margin="0,0,0,5" Background="#111C3126">
                                        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1" StrokeDashArray="3 2" IsHitTestVisible="False">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Stroke" Value="#8FAE9D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, ElementName=FolderDropSurface}" Value="Dragging">
                                                            <Setter Property="Stroke" Value="#B5F2C9"/>
                                                            <Setter Property="Fill" Value="#2F7FDBA6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <StackPanel Orientation="Horizontal" Margin="11,0" VerticalAlignment="Center">
                                            <Path Width="15" Height="15" Margin="0,0,7,0" Stretch="Uniform"
                                                  Stroke="#E0F2E7" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M10,2 V11 M6.5,8 L10,11.5 L13.5,8 M3,12 V17 H17 V12"/>
                                            <TextBlock Foreground="#E1F1E7" FontSize="12" FontWeight="SemiBold"
                                                       Text="Drop a folder here" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource BackupCard}" Background="#FFFEFA" Padding="15,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="#E5F1E7" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Path Width="18" Height="18" Stretch="Uniform" Stroke="#31674E" StrokeThickness="1.6"
                                          StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Data="M4,4 H17 V17 H4 Z M2,7 H4 M2,11 H4 M2,15 H4 M7,13 L10,10 L14,14 M10.2,7.5 H10.3"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BackupCardTitle}" Text="Library"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Use Takeout to check for exact copies in your backup."/>
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="WelcomeLibrary" Style="{StaticResource ButtonBase}" Content="Open library" Padding="12,6" MinHeight="34"/>
                                    <TextBlock x:Name="WelcomeProfile" Grid.Column="1" Style="{StaticResource BackupLabel}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedItem, ElementName=ProfileSelect, TargetNullValue='My library', FallbackValue='My library'}"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Library profile {0}'}"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource BackupCard}" Background="#F0F6EF" Padding="15,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="#DDEDE3" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Path Width="14" Height="19" Stretch="Uniform" Stroke="#31674E" StrokeThickness="1.6"
                                          StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Data="M5,2 H13 Q15,2 15,4 V17 Q15,19 13,19 H5 Q3,19 3,17 V4 Q3,2 5,2 Z M7,15.5 H11"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BackupCardTitle}" Text="Pixel setup"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Pair your Pixel over USB to share folders over Wi-Fi."/>
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="WelcomeSetup" Style="{StaticResource ButtonBase}" Content="Open setup" Padding="12,6" MinHeight="34"/>
                                    <TextBlock x:Name="WelcomeDevice" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BackupLabel}">
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="ReviewView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource PageTitle}" Text="Review backup" Margin="0,0,0,9"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" PanningMode="VerticalOnly" VerticalContentAlignment="Stretch">
                    <Grid Margin="0,0,2,1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="158"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource BackupCard}" Background="#FFFEFB">
                            <StackPanel>
                                <Grid Margin="13,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="35" Height="35" Margin="0,0,10,0" Background="#E5F1E7" CornerRadius="8" VerticalAlignment="Center">
                                        <Path Width="20" Height="16" Stretch="Uniform" Stroke="#31674E" StrokeThickness="1.6"
                                              StrokeLineJoin="Round" Data="M2,7 V4.5 Q2,3 3.5,3 H8 L10.5,5.5 H18.5 Q20,5.5 20,7 V15.5 Q20,17 18.5,17 H3.5 Q2,17 2,15.5 Z M2,8 H20"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BackupLabel}" Text="Source folder"/>
                                        <TextBlock x:Name="FolderPath" Text="No folder selected" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Selected folder {0}'}"/>
                                    </StackPanel>
                                    <Button x:Name="ChangeFolder" Grid.Column="2" Style="{StaticResource ButtonBase}" Content="Change folder" VerticalAlignment="Center"/>
                                </Grid>
                                <Border BorderThickness="0,1,0,0" BorderBrush="#E4EBE2" Padding="13,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SkipCopies" IsChecked="True" Margin="0,0,9,0" VerticalAlignment="Center"
                                                  VerticalContentAlignment="Center" AutomationProperties.Name="Skip exact matches"
                                                  ToolTip="Exclude byte-for-byte matches from this share.">
                                            <TextBlock Text="Skip exact matches" TextWrapping="Wrap" Margin="3,0,0,0" FontSize="13"/>
                                        </CheckBox>
                                        <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource ButtonBase}" IsEnabled="False"
                                                Content="Rescan" MinHeight="30" Padding="10,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,8,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BackupCard}" Background="#FFFEFB" Padding="12,7">
                                <StackPanel>
                                    <TextBlock x:Name="TotalCount" Style="{StaticResource BackupCount}" Text="0"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Files found {0}'}"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Files found"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource BackupCard}" Background="#EAF4EB" BorderBrush="#D8E7D9" Padding="12,7">
                                <StackPanel>
                                    <TextBlock x:Name="ReadyCount" Style="{StaticResource BackupCount}" Text="0" Foreground="#226248"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Ready to share {0}'}"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Ready to share"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource BackupCard}" Background="#F6F1E7" BorderBrush="#E9E0CD" Padding="12,7">
                                <StackPanel>
                                    <TextBlock x:Name="CopyCount" Style="{StaticResource BackupCount}" Text="0" Foreground="#775026"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Exact matches {0}'}"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Exact matches"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DockPanel Grid.Row="2" Margin="0,0,0,5" LastChildFill="True">
                            <Button x:Name="WarningsButton" DockPanel.Dock="Right" Style="{StaticResource WhenAvailable}" IsEnabled="False"
                                    Content="Review warnings" MinHeight="28" Padding="9,3" ToolTip="See files the scan skipped or could not read."/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="File review" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Grid.Row="3" Style="{StaticResource BackupCard}" ClipToBounds="True" CornerRadius="9" Padding="1">
                            <Grid>
                                <!-- The table measures against its viewport while the surrounding view can still scroll. -->
                                <Canvas x:Name="FileViewport" ClipToBounds="True">
                                    <DataGrid x:Name="FileTable" IsTabStop="True" KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="File review" IsReadOnly="True" AutoGenerateColumns="False"
                                              Width="{Binding ActualWidth, ElementName=FileViewport}" Height="{Binding ActualHeight, ElementName=FileViewport}"
                                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                              CanUserResizeRows="False" CanUserSortColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Single" SelectionUnit="FullRow" MinRowHeight="30"
                                              BorderThickness="0" RowHeaderWidth="0" FontSize="13" Background="White" RowBackground="#FFFEFB"
                                              AlternatingRowBackground="#F5F8F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6EDE5"
                                              ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#EAF0E8"/>
                                                <Setter Property="Foreground" Value="#344F44"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="9,7"/>
                                                <Setter Property="BorderBrush" Value="#DDE6DC"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="Padding" Value="9,4"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#DDEFE2"/>
                                                        <Setter Property="Foreground" Value="#1D4738"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#44745C"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" SortMemberPath="RelativePath"
                                                                ElementStyle="{StaticResource FileCellText}" Width="2.40*" MinWidth="112"/>
                                            <DataGridTemplateColumn Header="Decision" SortMemberPath="Decision" Width="1.20*" MinWidth="99">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="7" HorizontalAlignment="Left" Padding="7,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#F2F0EB"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Decision}" Value="Ready"><Setter Property="Background" Value="#E1F2E7"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Decision}" Value="Known copy"><Setter Property="Background" Value="#EDE8F5"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Decision}" Value="Folder copy"><Setter Property="Background" Value="#F4EBD8"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Decision}" Style="{StaticResource BackupDecisionLabel}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Match" Binding="{Binding Match}" SortMemberPath="Match"
                                                                ElementStyle="{StaticResource FileCellText}" Width="1.85*" MinWidth="89"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" ElementStyle="{StaticResource FileCellText}"
                                                                Width="0.75*" MinWidth="72" CanUserSort="False"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Canvas>
                                <TextBlock IsHitTestVisible="False" Margin="12,26,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                            <Setter Property="Text" Value="No files to review"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=FileTable}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=ProgressBar}" Value="{x:Static Visibility.Visible}">
                                                    <Setter Property="Text" Value="Checking files…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Expander Grid.Row="4" Header="Connection details" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                                  HorizontalContentAlignment="Stretch">
                            <Grid Margin="18,4,8,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="101"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button x:Name="AccessButton" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource WhenAvailable}"
                                        IsEnabled="False" Content="Allow folder access" Margin="0,5,0,0" MinHeight="30" Padding="10,4"
                                        ToolTip="Give the paired Windows account read access to this folder."/>
                                <TextBlock Text="Share" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ShareStatus" Grid.Column="1" Text="Not sharing" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Windows reader" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ReaderStatus" Grid.Row="1" Grid.Column="1" Text="Checking Windows access…" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Text="Expires" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ExpiryStatus}" Value="—">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="ExpiryStatus" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="—"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Expander>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource BackupCard}" Background="#ECF4ED" BorderBrush="#D9E7DB"
                        Margin="0,7,2,0" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="Review this folder" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <ScrollViewer MaxHeight="57" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" Margin="0,2,0,0">
                            <TextBlock x:Name="StatusDetail" Text="Review the files before sharing them with your Pixel." Style="{StaticResource Caption}"/>
                        </ScrollViewer>
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="4" Margin="0,6,0,0" Visibility="Collapsed"
                                     Background="#D8E6DB" BorderThickness="0" Foreground="#36785C" AutomationProperties.Name="Operation progress"/>
                        <WrapPanel Margin="0,7,0,-2">
                            <Button x:Name="ShareButton" Style="{StaticResource PrimaryButton}" Content="_Start sharing" AutomationProperties.Name="Start sharing" AutomationProperties.AcceleratorKey="Alt+S" IsEnabled="False" Margin="0,0,7,3"/>
                            <Button x:Name="StopButton" Style="{StaticResource WhenAvailable}" Content="Stop sharing" IsEnabled="False" Margin="0,0,7,3"/>
                            <Button x:Name="ConfirmButton" Style="{StaticResource WhenAvailable}" Content="Confirm backup" IsEnabled="False"
                                    Margin="0,0,7,3" ToolTip="Record a backup you have verified in Google Photos."/>
                            <Button x:Name="CancelButton" Style="{StaticResource WhenAvailable}" Content="Cancel" IsEnabled="False"
                                    Margin="0,0,7,3" ToolTip="Cancel the current operation."/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="LibraryView" Grid.Column="1" Visibility="Collapsed" Margin="25,18,24,17">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Library" Margin="0"/>
                    <TextBlock Style="{StaticResource Body}" Text="Check for exact copies before your next backup." Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="LibraryProfileLabel" Text="Google Photos profile" FontSize="12"
                               Foreground="#465C51" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ProfileSelect" Width="168" MinHeight="36" FontSize="14" IsEditable="False"
                                  VerticalContentAlignment="Center" Padding="9,3" MaxDropDownHeight="250"
                                  AutomationProperties.LabeledBy="{Binding ElementName=LibraryProfileLabel}"
                                  ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="NewProfile" Style="{StaticResource ButtonBase}" Content="New profile"
                                MinHeight="36" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" Focusable="False" AutomationProperties.Name="Library content">
                <StackPanel Margin="0,0,2,3">
                    <Border Style="{StaticResource Card}" Background="#EDF5ED" BorderBrush="#D4E3D6" Padding="22,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Import from Google Photos" FontSize="23" FontWeight="SemiBold"
                                           Foreground="#182A24" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Body}" Text="Use your Google Takeout ZIPs or the extracted Google Photos folder."
                                           Foreground="#465C51" Margin="0,6,0,0"/>

                                <WrapPanel Margin="0,15,0,0">
                                    <Button x:Name="ImportZip" Style="{StaticResource PrimaryButton}" Content="Import ZIPs"
                                            MinHeight="38" Padding="15,6" Margin="0,0,8,4"
                                            AutomationProperties.Name="Import Google Takeout ZIPs"/>
                                    <Button x:Name="ImportFolder" Style="{StaticResource ButtonBase}" Content="Import folder"
                                            MinHeight="38" Padding="15,6" Margin="0,0,8,4"
                                            AutomationProperties.Name="Import extracted Google Photos folder"/>
                                    <Button x:Name="CancelImport" Style="{StaticResource WhenAvailable}" Content="Cancel import"
                                            IsEnabled="False" MinHeight="38" Margin="0,0,8,4"/>
                                </WrapPanel>

                                <TextBlock x:Name="ImportStatus" Text="" AutomationProperties.LiveSetting="Polite"
                                           Foreground="#465C51" Margin="0,7,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Add a Google Photos export or confirm a completed batch to build this library.">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" BorderBrush="#CDDCD0" BorderThickness="1,0,0,0" Padding="19,3,2,3"
                                    VerticalAlignment="Stretch">
                                <StackPanel MinWidth="94" VerticalAlignment="Center">
                                    <TextBlock x:Name="LibraryCount" Text="0" FontSize="34" FontWeight="SemiBold" Foreground="#19614D"
                                               Typography.NumeralAlignment="Tabular" TextWrapping="Wrap" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}, StringFormat='Known files {0}'}"/>
                                    <TextBlock Text="Known files" Foreground="#465C51" FontSize="13" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,15,0,0" Padding="18,15">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibraryCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibraryCount}" Value="—">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Repeated export paths" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="One photo can appear in several Takeout folders." Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="ExportReport" Grid.Column="1" Style="{StaticResource WhenAvailable}" Content="Save report"
                                        VerticalAlignment="Center" IsEnabled="False"
                                        AutomationProperties.Name="Save repeated export paths report"/>
                            </Grid>

                            <ListBox x:Name="AuditList" Margin="0,12,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                                     FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                     AutomationProperties.Name="Repeated export paths">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,7" BorderBrush="#E7EEE8" BorderThickness="0,1,0,0">
                                            <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Text="{Binding}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Expander Header="Manage local catalog" Foreground="#465C51" Margin="0,13,0,0" Padding="0,0,0,6">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibraryCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=LibraryCount}" Value="—">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,4,0,0">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="ClearCatalog" DockPanel.Dock="Right" Style="{StaticResource ButtonBase}"
                                        Content="Clear catalog" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Style="{StaticResource Body}" Text="Clear this profile’s saved file fingerprints."
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="SetupView" Grid.Column="1" Visibility="Collapsed" Margin="30,24,30,18"
      TextElement.Foreground="#182A24">
    <Grid.Resources>
        <Style x:Key="SetupSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#B9C9BE"/>
            <Setter Property="Foreground" Value="#234638"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="SetupCancel" TargetType="Button" BasedOn="{StaticResource SetupSecondary}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,17">
        <TextBlock Text="Your Pixel" Style="{StaticResource PageTitle}" Foreground="#182A24" Margin="0,0,0,3"/>
        <TextBlock Text="Pair once over USB. After that, your Pixel can back up folders from this PC over Wi-Fi."
                   FontSize="14" Foreground="#41594D" TextWrapping="Wrap"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly" Focusable="False">
        <StackPanel Margin="0,0,3,2">
            <Border Background="#203C32" CornerRadius="13" Padding="22,18,20,17">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="SetupHeading" Text="Pair with this PC" Foreground="#F7FAF3" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SetupInstructions" Text="Turn on USB debugging on your rooted Pixel or Pixel XL. Unlock the phone, connect it with a USB data cable, and approve the prompts on its screen."
                                   Foreground="#D7E6DC" FontSize="14" LineHeight="20" TextWrapping="Wrap" MaxWidth="560"
                                   HorizontalAlignment="Left" Margin="0,5,0,13"/>
                        <WrapPanel Margin="0,0,0,-4">
                            <Button x:Name="SetupBackup" Style="{StaticResource ButtonBase}" Content="Open backup" Visibility="Collapsed"
                                    MinHeight="38" Padding="17,7" Margin="0,0,8,4" Background="#C8ECD7"
                                    BorderBrush="#C8ECD7" Foreground="#163E2B"/>
                            <Button x:Name="PairPhone" MinHeight="38" Padding="17,7" Margin="0,0,8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}">
                                        <Setter Property="Content" Value="Pair my Pixel"/>
                                        <Setter Property="Background" Value="#C8ECD7"/>
                                        <Setter Property="BorderBrush" Value="#C8ECD7"/>
                                        <Setter Property="Foreground" Value="#163E2B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=SetupBackup}" Value="Visible">
                                                <Setter Property="Background" Value="#284A3C"/>
                                                <Setter Property="BorderBrush" Value="#698478"/>
                                                <Setter Property="Foreground" Value="#F2F8F1"/>
                                                <Setter Property="Content" Value="Pair a Pixel"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="OpenGuide" Style="{StaticResource ButtonBase}" Content="Setup guide"
                                    MinHeight="38" Padding="14,7" Margin="0,0,0,4" Background="#284A3C"
                                    BorderBrush="#698478" Foreground="#F2F8F1" ToolTip="Open the pairing guide in your browser."/>
                        </WrapPanel>
                        <TextBlock x:Name="UsbDeviceStatus" Text="Looking for your Pixel…" Foreground="#D0E5D7"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Viewbox Grid.Column="1" Width="108" Height="108" VerticalAlignment="Center"
                             IsHitTestVisible="False" Focusable="False">
                        <Canvas Width="112" Height="112">
                            <Path Data="M28,88 L28,96 C28,103 34,108 43,108 H64 C73,108 79,102 79,94 V88"
                                  Stroke="#84BDA1" StrokeThickness="3.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Rectangle Canvas.Left="15" Canvas.Top="9" Width="47" Height="79" RadiusX="7" RadiusY="7"
                                       Fill="#172F27" Stroke="#C7EBD3" StrokeThickness="2.2"/>
                            <Rectangle Canvas.Left="20" Canvas.Top="19" Width="37" Height="55" RadiusX="2" RadiusY="2" Fill="#A8DABE"/>
                            <Path Data="M20,56 L32,41 L38,48 L45,37 L57,52 V73 H20 Z" Fill="#55866F"/>
                            <Path Data="M20,63 L31,54 L39,62 L48,52 L57,59 V73 H20 Z" Fill="#315D4A"/>
                            <Ellipse Canvas.Left="27" Canvas.Top="26" Width="7" Height="7" Fill="#EFF5C9"/>
                            <Path Data="M35,14 H43 M36,80 H42" Stroke="#9FC0AD" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M74,88 V77 Q74,73 78,73 H81 Q85,73 85,77 V88 Z" Fill="#426F58" Stroke="#B6DBC2" StrokeThickness="1.8"/>
                            <Path Data="M76,72 V65 Q76,63 78,63 H81 Q83,63 83,65 V72" Stroke="#D6EDDA" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0" Background="#FFFFFF" BorderBrush="#D4DED5" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <StackPanel Margin="17,13,17,14">
                        <TextBlock Text="Pairing status" FontSize="15" FontWeight="SemiBold" Foreground="#203B2E"/>
                        <TextBlock x:Name="PairingStatus" Text="Checking this PC…" Margin="0,3,0,0" Foreground="#506057"
                                   FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Border BorderBrush="#E2E8E0" BorderThickness="0,1,0,0" Padding="17,12,17,13">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,13,0">
                                <TextBlock Text="Wi-Fi backups" FontSize="15" FontWeight="SemiBold" Foreground="#203B2E"/>
                                <TextBlock Text="Keep both devices on the same home network. Choose a folder in Backup, then check your uploads in Google Photos."
                                           Margin="0,3,0,0" FontSize="13" Foreground="#506057" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="OpenPhotos" Grid.Column="1" Style="{StaticResource SetupSecondary}" Content="Open Google Photos"
                                    VerticalAlignment="Center" ToolTip="View your Google Photos library in your browser."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Background="#FBFCF8" BorderBrush="#D4DED5" BorderThickness="1" CornerRadius="10" Padding="13,10">
                <Expander IsExpanded="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                          Foreground="#264735" AutomationProperties.Name="Advanced options">
                    <Expander.Header><TextBlock Text="Advanced options" FontWeight="SemiBold" FontSize="14" Margin="3,1,0,1"/></Expander.Header>
                    <StackPanel Margin="7,12,5,3">
                        <TextBlock Text="USB tools" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UsbToolsStatus" Text="Pixel Backup checks for USB tools when you pair or update your phone."
                                   Margin="0,3,0,8" Foreground="#506057" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <WrapPanel Margin="0,0,0,-4">
                            <Button x:Name="GetUsbTools" Style="{StaticResource SetupSecondary}" Content="Prepare USB tools" Margin="0,0,8,4"/>
                            <Button x:Name="BrowseAdb" Style="{StaticResource SetupSecondary}" Content="Choose adb.exe…" Margin="0,0,0,4"
                                    ToolTip="Use your own copy of adb.exe from Android Platform Tools."/>
                        </WrapPanel>
                        <Border BorderBrush="#DDE6DF" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,11,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Paired with an earlier version of Pixel Backup? Connect your phone over USB to update its backup helper."
                                           VerticalAlignment="Center" Foreground="#506057" FontSize="13" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                <Button x:Name="UpdateWatcher" Grid.Column="1" Style="{StaticResource SetupSecondary}" Content="Update backup helper"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Margin="0,12,3,0" BorderThickness="0,1,0,0" BorderBrush="#C9D6CB" Padding="2,10,0,1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Viewbox Width="17" Height="17" Margin="0,2,8,0" VerticalAlignment="Top" IsHitTestVisible="False">
                <Canvas Width="18" Height="18">
                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="16" Height="16" Stroke="#537261" StrokeThickness="1.4"/>
                    <Path Data="M9,8 V12 M9,5.5 V5.8" Stroke="#537261" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Viewbox>
            <ScrollViewer Grid.Column="1" MaxHeight="79" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <TextBlock x:Name="SetupStatus" Text="Ready for USB setup." FontSize="13" Foreground="#364C3F" TextWrapping="Wrap"
                           Margin="0,1,0,1" AutomationProperties.LiveSetting="Polite"/>
            </ScrollViewer>
            <Button x:Name="CancelSetup" Grid.Column="2" Style="{StaticResource SetupCancel}" Content="Cancel download"
                    IsEnabled="False" VerticalAlignment="Top" Margin="9,0,0,0"/>
        </Grid>
    </Border>
</Grid>
    </Grid>
</Window>
