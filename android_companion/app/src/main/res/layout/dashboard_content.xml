<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/dash_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="20dp">
        <LinearLayout android:id="@+id/dash_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="13dp">
            <LinearLayout android:id="@+id/dash_brand" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/dash_mark" android:layout_width="32dp" android:layout_height="32dp"
                    android:layout_marginEnd="9dp" android:importantForAccessibility="no"/>
                <TextView style="@style/DashHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/dash_title" android:textSize="24sp" android:accessibilityHeading="true"/>
            </LinearLayout>
            <Button android:id="@+id/dash_sources" style="@style/DashAction" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/dash_access"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/dash_panels" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:baselineAligned="false">
            <LinearLayout android:id="@+id/dash_meter_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/dash_meter_panel" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/DashText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/dash_light_text" android:text="@string/dash_rate_label" android:fontFamily="sans-serif-medium"
                    android:accessibilityHeading="true" android:labelFor="@id/dash_rate"/>
                <TextView android:id="@+id/dash_rate" style="@style/DashValue" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/dash_mint"
                    android:textSize="42sp" android:text="@string/dash_missing" android:contentDescription="@string/dash_unavailable"/>
                <Button android:id="@+id/dash_connect_rate" style="@style/DashMeterAction" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/dash_connect_meter"/>
                <FrameLayout android:id="@+id/dash_chart_host" android:layout_width="match_parent" android:layout_height="60dp"
                    android:layout_marginTop="4dp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/dash_chart_axis" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:visibility="gone"
                    android:orientation="horizontal" android:importantForAccessibility="noHideDescendants">
                    <TextView style="@style/DashCaption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:textColor="#BBD1C2" android:text="@string/dash_minute" android:textSize="12sp"/>
                    <TextView style="@style/DashCaption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#BBD1C2" android:text="@string/dash_now" android:textSize="12sp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="11dp"
                    android:layout_marginBottom="10dp" android:background="#436052" android:importantForAccessibility="no"/>
                <TextView style="@style/DashCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/dash_light_text" android:text="@string/dash_source_scope"/>
                <TextView android:id="@+id/dash_meter_detail" style="@style/DashCaption" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#BBD1C2"
                    android:text="@string/dash_wait_meter"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/dash_queue_column" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/dash_queue_panel" android:padding="17dp">
                    <TextView style="@style/DashHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/dash_queue" android:accessibilityHeading="true"/>
                    <LinearLayout android:id="@+id/dash_stats" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:orientation="horizontal" android:baselineAligned="false">
                        <LinearLayout android:id="@+id/dash_remaining_group" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/DashCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/dash_remaining" android:labelFor="@id/dash_remaining_value"/>
                            <TextView android:id="@+id/dash_remaining_value" style="@style/DashValue" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/dash_missing"
                                android:contentDescription="@string/dash_unavailable"/>
                        </LinearLayout>
                        <View android:id="@+id/dash_stats_line" android:layout_width="1dp" android:layout_height="match_parent"
                            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:background="@color/dash_line"
                            android:importantForAccessibility="no"/>
                        <LinearLayout android:id="@+id/dash_eta_group" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/DashCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/dash_eta" android:labelFor="@id/dash_eta_value"/>
                            <TextView android:id="@+id/dash_eta_value" style="@style/DashValue" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/dash_missing"
                                android:contentDescription="@string/dash_unavailable"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/dash_photos_detail" style="@style/DashCaption" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/dash_wait_photos"/>
                    <Button android:id="@+id/dash_manual" style="@style/DashAction" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/dash_record"/>
                </LinearLayout>
                <Button android:id="@+id/dash_open" style="@style/DashPrimaryAction" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/dash_open_photos"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
